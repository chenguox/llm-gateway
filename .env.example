APP_NAME="LLM Gateway"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Each logical model references its own key variable in config/models.json.
# Leave a key empty to keep that model unavailable without blocking other models.
MODELS_CONFIG_PATH=config/models.json
GENERAL_CHAT_API_KEY=
CODING_ASSISTANT_API_KEY=
FLASH_CHAT_API_KEY=

CALL_RECORDS_PATH=data/calls.sqlite3
CALL_RECORDS_RETENTION_DAYS=30
PRICES_CONFIG_PATH=config/prices.json

# Optional: use an independent secret of at least 32 bytes for prompt fingerprints.
# Empty disables content fingerprints; prompt metadata is still recorded.
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_ID=v1
